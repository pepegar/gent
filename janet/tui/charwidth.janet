    0x25FB 0x25FC    # Medium squares
    0x2600 0x2604    # Sun, Cloud, etc.
    0x260E 0x260E    # Telephone
    0x2611 0x2611    # Ballot Box with Check
    0x2618 0x2618    # Shamrock
