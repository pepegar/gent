    0x2934 0x2935    # Arrows
    0x3030 0x3030    # Wavy Dash
    0x303D 0x303D    # Part Alternation Mark
    0xFE0F 0xFE0F])  # Variation Selector 16 (emoji presentation)

(defn char-width
  "Return the display width of a single-character string.
   Returns 0 for empty strings and combining/zero-width chars,
   2 for wide/fullwidth, 1 otherwise.
   Control chars (< 0x20) except tab return 0."
  [ch]
  (when (not (string? ch)) (break 1))
  (def len (length ch))
  (when (= len 0) (break 0))
  (def b0 (get ch 0))
  # ASCII fast path
  (when (< b0 0x20) (break 0))
  (when (< b0 0x7F) (break 1))
  # DEL
  (when (= b0 0x7F) (break 0))
  # Decode codepoint
  (def cp (codepoint ch))
  # Check zero-width
  (when (in-ranges? cp zero-width-ranges) (break 0))
  # Check wide
  (when (in-ranges? cp wide-ranges) (break 2))
  # Check ambiguous-wide
  (when (in-ranges? cp ambiguous-wide-ranges) (break 2))
  # Default
  1)

(defn string-width
  "Return the total display width of a string."
  [s]
  (var w 0)
  (var i 0)
  (def len (length s))
  (while (< i len)
    (def b0 (get s i))
    (def char-len
      (cond (< b0 0x80) 1 (< b0 0xE0) 2 (< b0 0xF0) 3 4))
    (def end (min (+ i char-len) len))
    (def ch (string/slice s i end))
    (+= w (char-width ch))
    (set i end))
  w)
