# tui/charwidth.janet — Unicode character display width.
#
# Returns the number of terminal columns a character occupies:
#   0 for combining marks and zero-width chars
#   2 for CJK, fullwidth, and common wide symbols
#   1 for everything else
#
# Based on Unicode East Asian Width + emoji ranges.
# Matches real terminal behavior (iTerm2, Terminal.app, kitty).

(defn- codepoint [ch]
  "Extract the Unicode codepoint from a single-character string."
  (def len (length ch))
  (when (= len 0) (break 0))
  (def b0 (get ch 0))
  (cond
    (< b0 0x80) b0
    (< b0 0xE0)
    (if (< len 2) b0
      (bor (blshift (band b0 0x1F) 6)
           (band (get ch 1) 0x3F)))
    (< b0 0xF0)
    (if (< len 3) b0
      (bor (blshift (band b0 0x0F) 12)
           (blshift (band (get ch 1) 0x3F) 6)
           (band (get ch 2) 0x3F)))
    (if (< len 4) b0
      (bor (blshift (band b0 0x07) 18)
           (blshift (band (get ch 1) 0x3F) 12)
           (blshift (band (get ch 2) 0x3F) 6)
           (band (get ch 3) 0x3F)))))

(defn- in-ranges? [cp ranges]
  "Check if codepoint falls within any [lo hi] range pair."
  (var i 0)
  (var found false)
  (while (and (not found) (< i (length ranges)))
    (def lo (get ranges i))
    (def hi (get ranges (+ i 1)))
    (when (and (>= cp lo) (<= cp hi))
      (set found true))
    (set i (+ i 2)))
  found)

